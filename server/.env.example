# Copy to .env and fill in for real email delivery. Without these set, the
# server logs what it would have sent instead of sending it, and /api/alerts
# responds ok:false so the client keeps retrying (it never lies about delivery).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Eyes on Me <alerts@yourdomain.example>"

# Restrict which origin can call this API. "*" is fine for local dev only.
ALLOWED_ORIGIN=*

# Bearer token required for GET /api/discomfort/export.csv. Leave unset to
# disable the export endpoint entirely (it 401s with no ADMIN_TOKEN set).
ADMIN_TOKEN=

PORT=8787
DB_PATH=./data/eyes-on-me.sqlite
