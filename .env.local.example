# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase — Project Settings -> API
# (server-only: the client never talks to Supabase directly, so no NEXT_PUBLIC_* needed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Admin dashboard (/admin) — pick your own password; generate the secret with
# `openssl rand -hex 32` or similar. Changing the secret invalidates all
# existing admin sessions.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
